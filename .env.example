# DeepSeek V4 Pro：官方 OpenAI 兼容接口，默认关闭思考。
APIKEY=sk-your-api-key
API=https://api.deepseek.com
MODEL=deepseek-v4-pro
# enabled 开启思考；CLI 的 --thinking / --no-thinking 优先于此配置。
RESEARCH_DEEPSEEK_THINKING=disabled
# 思考强度：low / high / max，默认 high；CLI --reasoning-effort 优先。
RESEARCH_DEEPSEEK_REASONING_EFFORT=high
# 辅助请求（记忆、压缩、Skills）独立配置，推荐保持关闭。
RESEARCH_DEEPSEEK_SIDE_THINKING=disabled
RESEARCH_DEEPSEEK_SIDE_REASONING_EFFORT=low
# USD 费用估算：peak（默认保守峰价）或 off_peak，不是实际账单。
RESEARCH_DEEPSEEK_PRICE_PERIOD=peak

# Optional generic aliases supported by ResearchAgent.
# MINI_CLAUDE_API_KEY=sk-your-api-key
# MINI_CLAUDE_API_BASE=https://api.deepseek.com/anthropic

# Anthropic native config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=gpt-4o

# Built-in web_search. Only the selected provider needs a key.
RESEARCH_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your-tavily-api-key
# SERPER_API_KEY=your-serper-api-key
