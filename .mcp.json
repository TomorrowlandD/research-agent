{
  "mcpServers": {
    "context7": {
      "roles": [],
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "roles": ["explore"],
      "allowed_tools": ["browser_navigate", "browser_snapshot", "browser_click", "browser_type",
                        "browser_wait_for", "browser_navigate_back", "browser_press_key", "browser_close"],
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.86", "--headless", "--image-responses", "omit", "--isolated", "--browser", "chromium"]
    }
  }
}
